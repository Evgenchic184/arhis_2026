APP_NAME=Arhis API
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arhis
REDIS_URL=redis://localhost:6379/0
FEATURE_STORE_NAMESPACE=arhis
METRICS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3})(:\\d+)?$
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
