APP_NAME=Arhis API
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arhis
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_DOMAIN_EVENTS_TOPIC=arhis.domain.events
KAFKA_MODERATION_ML_REQUESTS_TOPIC=arhis.moderation.ml.requests
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=arhis-event-logs
MODEL_REGISTRY_BUCKET_NAME=arhis-model-registry
RETRAINING_DATASET_BUCKET_NAME=arhis-retraining-datasets
S3_REGION_NAME=us-east-1
S3_USE_SSL=false
PROMETHEUS_BASE_URL=http://localhost:9090
PARQUET_SINK_PREFIX=event_logs
PARQUET_SINK_FLUSH_ROWS=100
PARQUET_SINK_FLUSH_SECONDS=10
MODERATION_ML_ROUTE_RATE=0.8
MODERATION_ML_MANUAL_SAMPLE_RATE=0.1
MODERATION_ML_CONFIDENCE_THRESHOLD_LOW=0.65
MODERATION_ML_CONFIDENCE_THRESHOLD_HIGH=0.9
MODEL_REGISTRY_CANARY_TRAFFIC_PERCENT=10
MODEL_REGISTRY_VALIDATION_SAMPLE_SIZE=32
MODEL_REGISTRY_REQUIRED_ACCURACY=1.0
MODEL_REGISTRY_AUTO_PROMOTE_ENABLED=true
MODEL_REGISTRY_AUTO_PROMOTE_CHECK_INTERVAL_SECONDS=60
MODEL_REGISTRY_AUTO_PROMOTE_MIN_AGE_SECONDS=300
MODEL_REGISTRY_AUTO_PROMOTE_MIN_REPORTS=100
MODEL_REGISTRY_AUTO_PROMOTE_MIN_MANUAL_SAMPLES=5
MODEL_REGISTRY_ENABLED=true
ML_WORKER_METRICS_PORT=8011
ML_MODEL_PATH=models/cyberbullying_moderation.joblib
ML_MODEL_VERSION=dev
MODEL_REGISTRY_CACHE_DIR=models/cache
MODEL_REGISTRY_MODEL_NAME=cyberbullying_moderation
RETRAINING_ENABLED=true
RETRAINING_COOLDOWN_SECONDS=86400
RETRAINING_MONITOR_INTERVAL_SECONDS=600
RETRAINING_DATA_WINDOW_HOURS=168
RETRAINING_MANUAL_SAMPLE_WINDOW_HOURS=168
RETRAINING_PSI_THRESHOLD=0.2
RETRAINING_NEW_TOKEN_SHARE_THRESHOLD=0.1
RETRAINING_MANUAL_ACCURACY_THRESHOLD=0.95
RETRAINING_MANUAL_ACCURACY_DROP_THRESHOLD=0.05
RETRAINING_MANUAL_ACCURACY_MIN_SAMPLES=20
RETRAINING_MONITOR_METRICS_PORT=8012
FEATURE_STORE_NAMESPACE=arhis
METRICS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3})(:\\d+)?$
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
